{
  "name": "@bctrl/sdk",
  "version": "3.0.0",
  "description": "The official TypeScript library for the BCTRL API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bctrlhq/sdk-js.git"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/cjs/node.d.ts",
        "default": "./dist/cjs/node.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "test": "tsx --test tests/v1/*.test.ts tests/v1/e2e/*.test.ts",
    "test:e2e": "BCTRL_E2E=1 tsx --test tests/v1/e2e/**/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "check:package": "node scripts/check-package.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.12.4",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.0",
    "publint": "0.3.24",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "files": [
    "dist"
  ]
}
